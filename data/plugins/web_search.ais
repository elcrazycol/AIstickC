# name: web_search
# description: Найти свежую информацию в интернете и ответить по ней. Вызывай, когда спрашивают о новостях, курсах, ценах, событиях, версиях или о чём угодно, что могло измениться после обучения. Для погоды не нужен — для неё есть отдельный инструмент.
# params: query*
# label: ищу в интернете

r = proxy_post("/search", query)
note(json(r, "note"))
summarize(json(r, "text"))
