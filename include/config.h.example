// Шаблон секретов. Скопируй в config.h и заполни.
// config.h в .gitignore и в репозиторий не попадает.
#pragma once

// --- Прокси распознавания на твоём VPS ---
// Стик ходит к нему, а он — в Groq Whisper. Так обходится гео-блок,
// и ключ Groq остаётся на сервере, а не в прошивке.
//
// PROXY_HOST — домен, привязанный к серверу
#define PROXY_HOST "example.com"
// PROXY_PORT — порт прокси (тот же, что в /etc/stt-proxy.env)
#define PROXY_PORT 8443
// PROXY_PATH — путь эндпоинта
#define PROXY_PATH "/stt"
// PROXY_TOKEN — общий секрет, тот же AUTH_TOKEN, что на сервере
#define PROXY_TOKEN ""

// --- LLM (OpenCode Go) ---
// Ключ подписки OpenCode Go. Эндпоинт opencode.ai доступен из России
// напрямую, поэтому прокси, в отличие от распознавания, не нужен.
#define OPENCODE_API_KEY ""

// --- Wi-Fi 2.4 ГГц (5 ГГц ESP32 не поддерживает) ---
#define WIFI_SSID ""
#define WIFI_PASS ""
